{
  "logo": {
    "type": "small",
  },
  "display": {
    "separator": "",
    "key": {
      "width": 15,
    },
  },
  "modules": [
    {
      "key": " user",
      "type": "title",
      "format": "{user-name}",
      "keyColor": "31",
    },
    {
      "key": "󰇅 hostname",
      "type": "title",
      "format": "{host-name}",
      "keyColor": "32",
    },
    {
      "key": "󰅐 uptime",
      "type": "uptime",
      "keyColor": "33",
    },
    {
      "key": "{icon} distro",
      "type": "os",
      "keyColor": "34",
    },
    {
      "key": " kernel",
      "type": "kernel",
      "keyColor": "35",
    },
    {
      "key": "󰇄 desktop",
      "type": "de",
      "keyColor": "36",
    },
    {
      "key": " term",
      "type": "terminal",
      "keyColor": "31",
    },
    {
      "key": " shell",
      "type": "shell",
      "keyColor": "32",
    },
    {
      "key": "󰍛 cpu",
      "type": "cpu",
      "showPeCoreCount": true,
      "keyColor": "33",
    },
    {
      "key": "󰉉 disk",
      "type": "disk",
      "folders": "/",
      "keyColor": "34",
    },
    {
      "key": " memory",
      "type": "memory",
      "keyColor": "35",
    },
    {
      "key": "󰩟 network",
      "type": "localip",
      "format": "{ipv4} ({ifname})",
      "keyColor": "36",
    },
    {
      "key": " OS age",
      "type": "command",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
      "keyColor": "32",
    },
    {
      "key": " colors",
      "type": "colors",
      "symbol": "circle",
      "keyColor": "39",
    },
  ],
}
